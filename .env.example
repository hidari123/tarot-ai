# ============================================================
# Mystic Tarot · 环境变量样例
#
# 复制为 .env.local 并填入真实值：
#   cp .env.example .env.local
# ⚠️ .env.local 已被 .gitignore 排除，勿提交到版本库
# ============================================================

# ---------- 主模型（必填）----------
# OpenAI 兼容协议，任选其一配置
DEEPSEEK_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ---------- 备用模型（可选，强烈建议配）----------
# 主模型不可用时自动切换（网络错误 / 5xx / 429 / 超时）
FALLBACK_API_KEY=your-fallback-key
FALLBACK_BASE_URL=https://api.minimaxi.com/v1
FALLBACK_MODEL=MiniMax-M3

# 指定首选 provider 名称（与 OPENAI_MODEL / FALLBACK_MODEL 对应）
# 例：PRIMARY_PROVIDER=MiniMax-M3
# PRIMARY_PROVIDER=deepseek-chat

# failover 粘性窗口（毫秒）：切换后这段时间内不探测主用
# FAILOVER_STICKY_MS=600000

# ---------- Agent 行为 ----------
# react = 默认 ReAct（一步一决策）| plan = Plan-Execute（先出仪轨计划再执行）
AGENT_MODE=react

# 工具循环轮次上限（逐张解读模式约需 14 轮）
MAX_ROUNDS=22

# 单次 LLM 调用超时（毫秒）；analyst 输出长会自动放宽到 90s
LLM_TIMEOUT_MS=45000

# HITL 等待用户应答上限（毫秒）
HITL_TIMEOUT_MS=300000

# 单场占卜的活跃处理时间上限（毫秒，不计用户思考时间）
SESSION_DEADLINE_MS=720000

# ---------- 速率限制（滑动窗口）----------
# ⚠️ 上游网关通常有滚动窗口配额（实测某内网网关：滚动 ~60 秒内最多 4 次）。
#    滑动窗口记录"窗口内的请求时间戳"，滚动剔除过期记录 ——
#    语义与上游配额**逐字一致**。
#    ⚠️ 第一版用令牌桶（"空闲攒额度"）—— 实测 30 秒内发了 8 次、第 9 次 429：
#    攒额度后连发 → 全落在同一窗口 → 必然超限。**"差不多"的限流语义是有害的**。
LLM_RATE_PER_MIN=20           # 窗口内允许的请求数
LLM_RATE_BURST=20             # 窗口容量（并发占位，保证并发下不穿透）
LLM_RATE_WINDOW_MS=60000     # 窗口长度（毫秒）—— 必须与上游配额窗口一致
# LLM_RATE_ENABLED=0          # 设为 0 关闭限流（配额充足时）
# ⚠️ 收到 429 会自动收紧该 provider 的窗口容量（AIMD 乘性减，per-provider 独立）

# ---------- 并行择优（Hedged Request）----------
# ⚠️ 默认关闭：并行 = 消耗双倍配额。
#    开启后，仅在「主用 provider 近期失败过」时才双路竞速（谁先回用谁），
#    把主用挂掉时的 45~80 秒等待压缩到最快那路的响应时间。
# LLM_HEDGED_ENABLED=1

# ---------- 多模型 failover ----------
# 主用失败后的粘性窗口（毫秒）：这段时间内直接用备用，不再探测主用
# FAILOVER_STICKY_MS=600000

# ---------- RAG ----------
# local = 本地 ONNX 嵌入（首次启动会下载模型）| remote = 远程 embedding API
RAG_VECTOR_MODE=local
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# HF_ENDPOINT=https://hf-mirror.com   # 国内加速（可选）
# MODEL_TIMEOUT_MS=60000

# ---------- 数据 ----------
# SQLite 落盘目录（相对项目根 / 容器 /app/data）
# DATA_RETENTION_DAYS=90

# ---------- 公网部署安全（P1-④）----------
# ⚠️ DASHBOARD_TOKEN：**公网部署必填**
#    观测面板返回全站用户的占卜内容（问题原文 + 解读全文）——
#    未配置时面板 **fail closed**（拒绝访问），这是刻意的：
#    公网部署下"没配置就放开"是危险的默认值。
#    本地开发用 dev，正式部署请改成随机长串。
#    生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_TOKEN=dev

# ⚠️ USER_KEY_SALT：跨会话画像主键的盐
#    未配置时用默认值 —— 正式部署**必须**改掉
#    （已知盐 + 猜测的 IP/UA 可离线枚举出所有画像主键）
USER_KEY_SALT=mystic-tarot-local-salt-change-me

# ---------- CORS（P3-⑭）----------
# ⚠️ 同源部署**不要设**（浏览器默认禁止跨域 = 最严格的白名单）。
#    只有前后端**不同域**时才需要，且必须是精确域名（绝不能是 *）。
# CORS_ORIGINS=https://tarot.example.com

# ---------- 部署 ----------
# PORT=3000
# ⚠️ 单 worker：项目有跨请求共享的内存状态（会话表/SSE 缓冲/限流窗口/熔断器），
#    globalThis 解决不了多进程分裂。详见 docs/deployment.md 第六章。
# NODE_OPTIONS=--max-old-space-size=2048

# 本地预览：设为 1 可禁用 Service Worker（避免 SW 缓存导致看到旧页面）
# 部署环境请勿设置
# NEXT_PUBLIC_DISABLE_SW=1
