# ============================================================
# Mystic Tarot · 环境变量样例
#
# 复制为 .env.local 并填入真实值：
#   cp .env.example .env.local
# ⚠️ .env.local 已被 .gitignore 排除，勿提交到版本库
# ============================================================

# ---------- 主模型（必填）----------
# OpenAI 兼容协议，任选其一配置
DEEPSEEK_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ---------- 备用模型（可选，强烈建议配）----------
# 主模型不可用时自动切换（网络错误 / 5xx / 429 / 超时）
FALLBACK_API_KEY=your-fallback-key
FALLBACK_BASE_URL=https://api.minimaxi.com/v1
FALLBACK_MODEL=MiniMax-M3

# 指定首选 provider 名称（与 OPENAI_MODEL / FALLBACK_MODEL 对应）
# 例：PRIMARY_PROVIDER=MiniMax-M3
# PRIMARY_PROVIDER=deepseek-chat

# failover 粘性窗口（毫秒）：切换后这段时间内不探测主用
# FAILOVER_STICKY_MS=600000

# ---------- Agent 行为 ----------
# react = 默认 ReAct（一步一决策）| plan = Plan-Execute（先出仪轨计划再执行）
AGENT_MODE=react

# 工具循环轮次上限（逐张解读模式约需 14 轮）
MAX_ROUNDS=22

# 单次 LLM 调用超时（毫秒）；analyst 输出长会自动放宽到 90s
LLM_TIMEOUT_MS=45000

# HITL 等待用户应答上限（毫秒）
HITL_TIMEOUT_MS=300000

# 单场占卜的活跃处理时间上限（毫秒，不计用户思考时间）
SESSION_DEADLINE_MS=480000

# ---------- RAG ----------
# local = 本地 ONNX 嵌入（首次启动会下载模型）| remote = 远程 embedding API
RAG_VECTOR_MODE=local
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# HF_ENDPOINT=https://hf-mirror.com   # 国内加速（可选）
# MODEL_TIMEOUT_MS=60000

# ---------- 数据 ----------
# SQLite 落盘目录（相对项目根 / 容器 /app/data）
# DATA_RETENTION_DAYS=90

# ---------- 部署 ----------
# PORT=3000
